{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Mises à jour de @otomata_tech/oto_platform dans une application hôte (ADR-006, ADR-010)",
  "packageRules": [
    {
      "description": "Correctives : version épinglée, fusion automatique si la CI est verte",
      "matchPackageNames": ["@otomata_tech/oto_platform"],
      "matchUpdateTypes": ["patch"],
      "rangeStrategy": "pin",
      "automerge": true
    },
    {
      "description": "Mineures : revue humaine (D121)",
      "matchPackageNames": ["@otomata_tech/oto_platform"],
      "matchUpdateTypes": ["minor"],
      "rangeStrategy": "pin",
      "automerge": false,
      "labels": ["oto-platform-minor"]
    },
    {
      "description": "Majeures : revue humaine",
      "matchPackageNames": ["@otomata_tech/oto_platform"],
      "matchUpdateTypes": ["major"],
      "rangeStrategy": "pin",
      "automerge": false,
      "labels": ["oto-platform-major"]
    }
  ]
}
